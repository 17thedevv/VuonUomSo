{
  "name": "vuonuom-server",
  "version": "3.1.0",
  "description": "Vườn Ươm V3 Cloud-backed NestJS Server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test scripts prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oxlint": "1.81.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
