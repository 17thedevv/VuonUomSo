# Vườn Ươm V3 Server Environment Configuration Example
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vuonuom_dev?schema=public
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_JWT_ISSUER=https://placeholder-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://placeholder-project.supabase.co/auth/v1/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SYNC_CURSOR_HMAC_KEY=placeholder-hmac-key-for-local-dev-min-32-chars
APP_ORIGIN=http://localhost:5173
